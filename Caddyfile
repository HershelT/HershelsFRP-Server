# Caddyfile for HershelsFRP
# Location: /etc/caddy/Caddyfile (on your Azure VM)
# Caddy version: 2.8+

# ============================================================
# Global Options
# ============================================================
{
    # Email for Let's Encrypt certificate notifications
    # CHANGE THIS to your email address!
    email your-email@example.com

    # Enable on-demand TLS for wildcard subdomains
    # This allows automatic SSL certificate generation for any subdomain
    on_demand_tls {
        # Ask endpoint to prevent certificate abuse
        # This checks if a subdomain is authorized before issuing a cert
        ask http://localhost:9000/ask
    }

    # Optional: Enable admin API for monitoring
    admin localhost:2019
}

# ============================================================
# Wildcard Subdomain Handler
# ============================================================

# Matches all subdomains: *.tunnel.hershel.dev
# Examples:
# - alice-myapp-client.tunnel.hershel.dev
# - bob-api-server.tunnel.hershel.dev
*.tunnel.hershel.dev {
    # Enable on-demand TLS (automatic HTTPS)
    # Caddy will automatically get Let's Encrypt certificates
    # for each subdomain when first requested
    tls {
        on_demand
    }

    # Reverse proxy to FRP's internal HTTP port
    reverse_proxy localhost:8080 {
        # Pass original headers to backend
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Enable WebSocket support (automatically upgrades HTTP to WebSocket)
        # This is required for Socket.io, YJS, and other real-time apps

        # Health check (optional)
        # health_uri /health
        # health_interval 30s
        # health_timeout 5s

        # Timeout settings
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }

    # Logging for debugging
    log {
        output file /var/log/caddy/tunnel-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
        level INFO
    }

    # Optional: Add security headers
    header {
        # Remove server header (security through obscurity)
        -Server

        # Add security headers (adjust as needed)
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ============================================================
# Base Domain Handler (Optional)
# ============================================================

# Main domain - serves the platform web app
tunnel.hershel.dev {
    # Reverse proxy API requests to the platform server
    handle /api/* {
        reverse_proxy localhost:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Serve static files from the platform
    handle {
        reverse_proxy localhost:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Logging
    log {
        output file /var/log/caddy/platform-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
        level INFO
    }
}

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
#
# 1. Install Caddy on your Azure VM:
#    Ubuntu/Debian:
#      sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https
#      curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#      curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#      sudo apt update
#      sudo apt install caddy
#
# 2. Copy this file to /etc/caddy/Caddyfile:
#    sudo cp Caddyfile /etc/caddy/Caddyfile
#
# 3. CHANGE THE EMAIL ADDRESS in the global options above!
#
# 4. Create log directory:
#    sudo mkdir -p /var/log/caddy
#    sudo chown caddy:caddy /var/log/caddy
#
# 5. Set up the ask endpoint (see ask-server.js and setup-ask-service.sh)
#
# 6. Test configuration:
#    sudo caddy validate --config /etc/caddy/Caddyfile
#
# 7. Reload Caddy:
#    sudo systemctl reload caddy
#
# 8. Check status:
#    sudo systemctl status caddy
#
# 9. View logs:
#    sudo journalctl -u caddy -f
#
# 10. Test on-demand TLS:
#     curl -I https://test.tunnel.hershel.dev
#     (Should get a valid SSL certificate automatically!)
#
