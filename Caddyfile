# Caddyfile for HershelsFRP
# Location: /etc/caddy/Caddyfile (on your Azure VM)
# Caddy version: 2.8+

# ============================================================
# Global Options
# ============================================================
{
    # Email for Let's Encrypt certificate notifications
    # CHANGE THIS to your email address!
    email your-email@example.com

    # Enable on-demand TLS for wildcard subdomains
    # This allows automatic SSL certificate generation for any subdomain
    on_demand_tls {
        # Ask endpoint to prevent certificate abuse
        # This checks if a subdomain is authorized before issuing a cert
        ask http://localhost:9000/check-subdomain
    }

    # Optional: Enable admin API for monitoring
    admin localhost:2019
}

# ============================================================
# Wildcard Subdomain Handler
# ============================================================

# Matches all subdomains: *.tunnel.hershel.dev
# Examples:
# - alice-myapp-client.tunnel.hershel.dev
# - bob-api-server.tunnel.hershel.dev
*.tunnel.hershel.dev {
    # Enable on-demand TLS (automatic HTTPS)
    # Caddy will automatically get Let's Encrypt certificates
    # for each subdomain when first requested
    tls {
        on_demand
    }

    # Reverse proxy to FRP's internal HTTP port
    reverse_proxy localhost:8080 {
        # Pass original headers to backend
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Enable WebSocket support (automatically upgrades HTTP to WebSocket)
        # This is required for Socket.io, YJS, and other real-time apps

        # Health check (optional)
        # health_uri /health
        # health_interval 30s
        # health_timeout 5s

        # Timeout settings
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }

    # Logging for debugging
    log {
        output file /var/log/caddy/tunnel-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
        level INFO
    }

    # Optional: Add security headers
    header {
        # Remove server header (security through obscurity)
        -Server

        # Add security headers (adjust as needed)
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ============================================================
# Base Domain Handler (Optional)
# ============================================================

# Main domain - shows info page or redirects
tunnel.hershel.dev {
    # Return a helpful message for people hitting the base domain
    respond 200 <<HTML
        <!DOCTYPE html>
        <html>
        <head>
            <title>HershelsFRP Tunnel Service</title>
            <style>
                body {
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                    max-width: 600px;
                    margin: 100px auto;
                    padding: 20px;
                    background: #0f172a;
                    color: #e2e8f0;
                }
                h1 { color: #38bdf8; }
                code {
                    background: #1e293b;
                    padding: 2px 6px;
                    border-radius: 4px;
                    color: #fbbf24;
                }
                .box {
                    background: #1e293b;
                    padding: 20px;
                    border-radius: 8px;
                    margin: 20px 0;
                    border-left: 4px solid #38bdf8;
                }
            </style>
        </head>
        <body>
            <h1>HershelsFRP Tunnel Service</h1>
            <div class="box">
                <p><strong>This is the HershelsFRP tunnel server.</strong></p>
                <p>To create tunnels, you need to:</p>
                <ol>
                    <li>Install the <strong>Localhost Tunnel & Preview</strong> VS Code extension</li>
                    <li>Set provider to <code>hershelsfrp</code> in settings</li>
                    <li>Configure your auth token</li>
                    <li>Start creating tunnels!</li>
                </ol>
            </div>
            <div class="box">
                <p><strong>Your tunnels will appear at:</strong></p>
                <p><code>https://username-project-role.tunnel.hershel.dev</code></p>
            </div>
            <p style="text-align: center; color: #64748b; margin-top: 40px;">
                Powered by <a href="https://github.com/fatedier/frp" style="color: #38bdf8;">FRP</a> +
                <a href="https://caddyserver.com" style="color: #38bdf8;">Caddy</a>
            </p>
            <div class="box" style="background: #334155; border-left-color: #f472b6;">
                <h2> Please visit HershelsFRP GitHub for full setup instructions! </h2>
                <p><a href="https://https://github.com/your-username/hershels-frp-tunnel" style="color: #f472b6;">
                HershelsFRP Documentation</a></p>
            </div>
        </body>
        </html>
    HTML

    header Content-Type text/html
    # Alternative: Redirect to documentation
    # redir https://github.com/your-username/hershels-frp-tunnel
}

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
#
# 1. Install Caddy on your Azure VM:
#    Ubuntu/Debian:
#      sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https
#      curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#      curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#      sudo apt update
#      sudo apt install caddy
#
# 2. Copy this file to /etc/caddy/Caddyfile:
#    sudo cp Caddyfile /etc/caddy/Caddyfile
#
# 3. CHANGE THE EMAIL ADDRESS in the global options above!
#
# 4. Create log directory:
#    sudo mkdir -p /var/log/caddy
#    sudo chown caddy:caddy /var/log/caddy
#
# 5. Set up the ask endpoint (see ask-server.js and setup-ask-service.sh)
#
# 6. Test configuration:
#    sudo caddy validate --config /etc/caddy/Caddyfile
#
# 7. Reload Caddy:
#    sudo systemctl reload caddy
#
# 8. Check status:
#    sudo systemctl status caddy
#
# 9. View logs:
#    sudo journalctl -u caddy -f
#
# 10. Test on-demand TLS:
#     curl -I https://test.tunnel.hershel.dev
#     (Should get a valid SSL certificate automatically!)
#
